# SPARING AQMS Monitoring — systemd service
#
# Instalasi (di Ubuntu/Raspberry Pi):
#   1. Sesuaikan User= dan path di bawah jika berbeda
#   2. sudo cp sparing.service /etc/systemd/system/
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl enable sparing
#   5. sudo systemctl start sparing
#
# Cek status / log:
#   systemctl status sparing
#   journalctl -u sparing -f

[Unit]
Description=SPARING AQMS Water Quality Monitoring
# Do NOT add `After=graphical.target` — this unit is WantedBy=graphical.target, so
# ordering it after that same target creates a boot-time ordering cycle; systemd then
# deletes the start job and the service is left inactive/dead after every reboot.
# Order after the display manager instead (a no-op if none exists) so X (:0) is up;
# Restart=always covers any remaining display-readiness race.
After=network-online.target display-manager.service
Wants=network-online.target

[Service]
Type=simple
User=mmsparing
WorkingDirectory=/home/mmsparing/sparing_python
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/mmsparing/.Xauthority
# Paksa Qt lewat X11/XWayland — fullscreen di Wayland murni sering
# tidak menutupi seluruh layar
Environment=QT_QPA_PLATFORM=xcb
ExecStart=/home/mmsparing/sparing_python/venv/bin/python main.py

# Best-effort "stopped" event on shutdown (works only if power/network survive;
# otherwise the server-side dead-man's switch reports the outage). Never blocks.
ExecStopPost=/home/mmsparing/sparing_python/venv/bin/python /home/mmsparing/sparing_python/last_gasp.py

# Restart otomatis apapun penyebab berhentinya (crash, window ditutup,
# listrik kembali setelah mati) — kunci mencegah gap data
Restart=always
RestartSec=10

[Install]
WantedBy=graphical.target
